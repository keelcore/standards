# containers/pypi/Containerfile
# keelcore-standards PyPI build image: CPython (.python-version) and the
# hash-locked build tooling (scripts/release/pypi/requirements-build.txt),
# installed once at build time. scripts/release/publish-pypi.sh builds the wheel
# and sdist in it (make publish-pypi) with nothing else installed.
# Build context: the repository root.

FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

COPY scripts/release/pypi/requirements-build.txt /opt/keelcore/requirements-build.txt
RUN python -m pip install --no-cache-dir --require-hashes --no-deps -r /opt/keelcore/requirements-build.txt

ENV KEELCORE_DEV_IMAGE=1

# The repository is mounted from the host (another owner); git trusts it.
RUN git config --system safe.directory '*'

WORKDIR /work
