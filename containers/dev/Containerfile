# containers/dev/Containerfile
# keelcore-standards dev image: every tool the canonical make targets run, at
# its pinned version, installed once at build time. Nothing is installed or
# updated at run time: scripts/dev/run.sh runs make targets in this image with
# the repository mounted read-only. Build context: the repository root.
#
# Base images are pinned by digest (multi-arch indexes: linux/amd64, linux/arm64).
# Tools are installed by the canonical setup scripts, each verifying its
# committed checksum, commit SHA, lockfile integrity or Go checksum database.

FROM node:22.23.4-trixie-slim@sha256:be1e2a3dc2c4fd68cdfadad2a696a280e0d2749098bee509230174d72fb768c6 AS node

FROM golang:1.27.3@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e

RUN apt-get update \
 && apt-get install -y --no-install-recommends jq unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Node (.nvmrc) from the official image; the npm CLI from its committed lockfile
# (scripts/ci/npm: npm ci checks every package against its integrity hash).
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY scripts/ci/npm/ /opt/npm-cli/
RUN /usr/local/bin/node /usr/local/lib/node_modules/npm/bin/npm-cli.js ci --prefix /opt/npm-cli \
      --ignore-scripts --no-audit --no-fund \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
 && ln -s /opt/npm-cli/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /opt/npm-cli/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV GOTOOLCHAIN=local \
    XDG_CACHE_HOME=/opt/cache \
    KEELCORE_DEV_IMAGE=1

COPY scripts/lib/local-hook.sh /opt/keelcore/scripts/lib/
COPY scripts/lib/markdownlint.sh /opt/keelcore/scripts/lib/
COPY scripts/ci/markdownlint/ /opt/keelcore/scripts/ci/markdownlint/

WORKDIR /opt/keelcore
# The setup scripts install only while the image is built (build-time only: an ARG never reaches
# the image); anywhere else they check the baked tool. One COPY + RUN per tool: a changed script
# rebuilds only its tool's layer and those after it.
# Largest layer first (each tool's compressed layer size, measured from a built image): a change to a small
# tool rebuilds only the small layers after it, and the big downloads stay cached.
ARG KEELCORE_IMAGE_BUILD=1
# layer: 107.2 MB
COPY scripts/ci/setup-kubescape.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-kubescape.sh
# layer: 53.5 MB
COPY scripts/ci/setup-cosign.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-cosign.sh
# layer: 32.2 MB
COPY scripts/ci/setup-gosec.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-gosec.sh
# layer: 28.4 MB
COPY scripts/ci/setup-grype.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-grype.sh
# layer: 27.3 MB
COPY scripts/ci/setup-syft.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-syft.sh
# layer: 17.6 MB
COPY scripts/ci/setup-helm.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-helm.sh
# layer: 11.3 MB
COPY scripts/ci/setup-shellcheck.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-shellcheck.sh
# layer: 9.3 MB
COPY scripts/ci/setup-go-licenses.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-go-licenses.sh && go clean -modcache -cache
# layer: 8.8 MB
COPY scripts/ci/setup-zizmor.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-zizmor.sh
# layer: 8.3 MB
COPY scripts/ci/setup-staticcheck.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-staticcheck.sh
# layer: 7.9 MB
COPY scripts/ci/setup-markdownlint.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-markdownlint.sh
# layer: 7.9 MB
COPY scripts/ci/setup-govulncheck.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-govulncheck.sh && go clean -modcache -cache
# layer: 7.3 MB
COPY scripts/ci/setup-gitleaks.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-gitleaks.sh
# layer: 6.6 MB
COPY scripts/ci/setup-kubeconform.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-kubeconform.sh
# layer: 2.3 MB
COPY scripts/ci/setup-gotestsum.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-gotestsum.sh
# layer: 2.0 MB
COPY scripts/ci/setup-actionlint.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-actionlint.sh
# layer: 0.0 MB
COPY scripts/ci/setup-bats.sh /opt/keelcore/scripts/ci/
RUN bash scripts/ci/setup-bats.sh

# The repository is mounted from the host (another owner); git trusts it.
RUN git config --system safe.directory '*'

WORKDIR /work
