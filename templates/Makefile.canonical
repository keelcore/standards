## Universal canonical targets (language-independent; mandated by CI standards)

build:
	@echo "🔨 Running build..."
	bash scripts/dev/run.sh bash scripts/build.sh

lint: lint-newlines lint-markdown lint-bash lint-go lint-suppressions lint-utc lint-workflows

test: test-unit test-integration

test-unit: test-unit-go test-unit-local

## The project's own unit tests (scripts/unit-test.local.sh)
test-unit-local:
	@echo "🧪 Running the project's unit tests..."
	bash scripts/dev/run.sh bash scripts/unit-test.sh

test-integration:
	@echo "🧪 Running integration tests..."
	bash scripts/dev/run.sh bash scripts/integration-test.sh

clean:
	@echo "🧹 Cleaning..."
	bash scripts/clean.sh

## Audit

audit:
	@echo "🔍 Running CI/Makefile audit..."
	bash scripts/dev/run.sh bash scripts/ci/audit-make-targets.sh

## Lint targets

lint-newlines:
	@echo "🔍 Checking trailing newlines..."
	bash scripts/dev/run.sh bash scripts/lint/newlines.sh

lint-utc:
	@echo "🕛 Checking timestamps are UTC..."
	bash scripts/dev/run.sh bash scripts/lint/utc.sh

lint-bash:
	@echo "🔍 Running shellcheck..."
	bash scripts/dev/run.sh bash scripts/lint/shellcheck.sh

lint-markdown:
	@echo "🔍 Running markdown lint (markdownlint-cli2)..."
	bash scripts/dev/run.sh bash scripts/lint/markdown.sh

lint-go:
	@echo "🔍 Running gofmt check + go vet + staticcheck..."
	bash scripts/dev/run.sh bash scripts/lint/go.sh

lint-suppressions:
	@echo "🔍 Checking for lint-suppression directives..."
	bash scripts/dev/run.sh bash scripts/lint/forbid-lint-suppressions.sh

## Check targets

check-adr-metadata:
	@echo "🔍 Checking ADR metadata..."
	bash scripts/dev/run.sh bash scripts/check/adr-metadata.sh

check-governance-metadata:
	@echo "🔍 Checking governance metadata..."
	bash scripts/dev/run.sh bash scripts/check/governance-metadata.sh

check-rfc-metadata:
	@echo "🔍 Checking RFC metadata..."
	bash scripts/dev/run.sh bash scripts/check/rfc-metadata.sh

## Last step of every CI job that runs tool targets: the job left the working tree untouched
check-clean-tree:
	@echo "🧹 Checking the working tree is clean..."
	bash scripts/ci/check-clean-tree.sh

## The pins docs/current_pins.md lists match the pins in the tree (local, no network; also a pre-commit check)
check-pins-doc:
	@echo "📌 Checking docs/current_pins.md against the pins in the tree..."
	bash scripts/dev/run.sh bash scripts/release/update-pins.sh --check-pins-doc docs/current_pins.md

check-legal-drift:
	@echo "⚖️  Checking legal file drift..."
	bash scripts/dev/run.sh bash scripts/check-legal-drift.sh

## CI gate targets

check-pr-policy:
	@echo "🔍 Running PR policy check..."
	bash scripts/dev/run.sh bash scripts/ci/pr-policy.sh

check-secrets:
	@echo "🔍 Running secret scan..."
	bash scripts/dev/run.sh bash scripts/ci/secret-scan.sh

check-dco:
	@echo "🔍 Running DCO sign-off check..."
	bash scripts/dev/run.sh bash scripts/ci/dco-check.sh

check-coverage-delta:
	@echo "📊 Checking coverage delta..."
	bash scripts/dev/run.sh bash scripts/test/coverage-delta.sh

check-governance:
	@echo "🚦 Governance CI gate (governance-refresh --dry-run)..."
	bash scripts/dev/run.sh bash scripts/ci/governance-gate.sh

## Coverage

test-coverage: test-coverage-go test-coverage-rust merge-coverage

test-coverage-go:
	@echo "📊 Go coverage..."
	bash scripts/dev/run.sh bash scripts/test/coverage-go.sh

test-coverage-rust:
	@echo "📊 Rust coverage (cargo-llvm-cov)..."
	bash scripts/dev/run.sh bash scripts/test/coverage-rust.sh

merge-coverage:
	@echo "📊 Coverage aggregate (merge per-language LCOV, bucket by extension)..."
	bash scripts/dev/run.sh bash scripts/test/coverage-aggregate.sh

check-coverage-regression:
	@echo "🚦 coverage-no-regression (per-file)..."
	bash scripts/dev/run.sh bash scripts/test/coverage-no-regression.sh

generate-coverage-baseline:
	@echo "🪴 coverage-baseline-init (capture current LCOV)..."
	bash scripts/dev/run.sh --writable bash scripts/test/coverage-baseline-init.sh

## Setup targets — the tool images run these installers at build time; `make setup-<tool>` runs
## one in the dev image (a throwaway install: how update-pins checks a new tool pin).

## Apple container and its kernel on this Mac, from the signed installer package (needs an administrator password).
setup-apple-container:
	@echo "🔧 Installing Apple container..."
	bash scripts/ci/setup-apple-container.sh

setup-bats:
	@echo "🔧 Installing bats-core test harness..."
	bash scripts/dev/run.sh bash scripts/ci/setup-bats.sh

setup-cosign:
	@echo "🔧 Installing cosign..."
	bash scripts/dev/run.sh bash scripts/ci/setup-cosign.sh

setup-gitleaks:
	@echo "🔧 Installing gitleaks..."
	bash scripts/dev/run.sh bash scripts/ci/setup-gitleaks.sh

setup-markdownlint:
	@echo "🔧 Installing markdownlint-cli..."
	bash scripts/dev/run.sh bash scripts/ci/setup-markdownlint.sh

setup-shellcheck:
	@echo "🔧 Installing shellcheck..."
	bash scripts/dev/run.sh bash scripts/ci/setup-shellcheck.sh

setup-staticcheck:
	@echo "🔧 Installing staticcheck..."
	bash scripts/dev/run.sh bash scripts/ci/setup-staticcheck.sh

setup-syft:
	@echo "🔧 Installing syft..."
	bash scripts/dev/run.sh bash scripts/ci/setup-syft.sh

setup-govulncheck:
	@echo "🔧 Installing govulncheck..."
	bash scripts/dev/run.sh bash scripts/ci/setup-govulncheck.sh

## Dependency vulnerability gate: reachable vulnerabilities in every repo-owned Go module
lint-vuln:
	@echo "🔍 Running govulncheck..."
	bash scripts/dev/run.sh bash scripts/lint/vuln.sh

## The CodeQL languages the repository holds, as a workflow output (codeql.yml). Runs on the host:
## the output file lives on the runner.
detect-codeql-languages:
	@echo "🔍 Detecting CodeQL languages..."
	bash scripts/ci/codeql-languages.sh

## Git hook installation (core.hooksPath scripts/hooks: one setting for clones, worktrees and submodules)

install-hooks:
	@echo "🪝 Installing git pre-commit hook..."
	bash scripts/install-hooks.sh

## Canonical script verification (compares a downstream repo's scripts/ against
## this canonical set; consumers usually do not invoke this).

verify-canonical:
	@echo "🔍 Verifying canonical scripts are byte-identical (REPO=<path>, default: this repo)…"
	bash scripts/dev/run.sh bash scripts/ci/verify-canonical-scripts.sh $(REPO)

## Utility targets

format:
	@echo "🖊️  Formatting repository..."
	bash scripts/dev/run.sh --writable bash scripts/format.sh

lint-all:
	@echo "🔍 Running all linters (full suite)..."
	bash scripts/dev/run.sh bash scripts/lint.sh

run-pre-commit:
	@echo "🪝 Running pre-commit checks..."
	bash scripts/git_precommit.sh

## Governance reconciliation (downstream consumers; ongoing, not first-time)
# Syncs canonical scripts from .standards/scripts/ to consumer scripts/ and
# injects any missing canonical Makefile target from
# .standards/templates/Makefile.canonical into consumer Makefile.
# `.standards` wins. Idempotent.
refresh-governance:
	bash scripts/governance-refresh.sh

## One-shot migration for consumers whose Makefile predates the include era.
## Adds the include directive and removes canonical target blocks. Idempotent.
migrate-makefile:
	bash scripts/migrate-makefile.sh

## Per-language publish targets — scripts shipped byte-identical (Rule A).
publish-go:
	@echo "🚀 Publishing Go module..."
	bash scripts/dev/run.sh bash scripts/release/go-publish.sh

publish-npm:
	@echo "🚀 Publishing npm package..."
	bash scripts/dev/run.sh --writable bash scripts/release/npm-publish.sh

## release-wait-published ARGS=npm|pypi|go: wait until the registry serves all of the version just published
## Wait for the GitHub Actions runs on this commit, then fail if any is red.
wait-for-ci:
	@echo "⏳ Waiting for CI on this commit..."
	bash scripts/release/wait-ci.sh

wait-for-publish:
	@echo "⏳ Waiting for the registry to finish publishing..."
	bash scripts/dev/run.sh bash scripts/release/wait-published.sh $(ARGS)

publish-pypi:
	@echo "🚀 Publishing PyPI package..."
	bash scripts/dev/run.sh --image pypi bash scripts/release/pypi-publish.sh

## Release provenance — SBOM (ARGS="--out-dir DIR") and keyless signing (ARGS="<artifact> ...").
generate-sbom:
	@echo "🧾 Generating SBOM..."
	bash scripts/dev/run.sh bash scripts/release/sbom.sh $(ARGS)

sign-release:
	@echo "🔏 Signing release artifacts..."
	bash scripts/dev/run.sh bash scripts/release/sign.sh $(ARGS)

## GitHub Release (publish workflow, after the packages are published): release-assets collects
## the published files in target/release with per-artifact SBOMs, build-environment SBOMs of
## the pinned tool images, current_pins.md, SHA256SUMS and cosign bundles; release-github
## creates the Release with notes and every asset; release-verify-blobs checks them all.
build-release-assets:
	@echo "📦 Assembling release assets for $(TAG)..."
	bash scripts/dev/run.sh bash scripts/release/release-assets.sh $(TAG) target/release

publish-github-release:
	@echo "🚀 Publishing the GitHub Release for $(TAG)..."
	bash scripts/dev/run.sh bash scripts/release/github-release.sh $(TAG) target/release

verify-release-blobs:
	@echo "🔍 Verifying release assets..."
	bash scripts/dev/run.sh bash scripts/release/verify-blobs.sh target/release

## Release tagging — developer action only (governance/ci.md "Release Tagging").
## The bump level comes from the repo's own scripts/release/create-release.local.sh.
## FORCE=vX.Y.Z overrides the computed version; DRY_RUN=1 computes without tagging.
## Stale pins block the release; ALLOW_STALE_PINS="<reason>" authorizes it (audit-logged).
create-release:
	@echo "🏷️  Creating release tag..."
	bash scripts/release/create-release.sh $(if $(FORCE),--force $(FORCE),) $(if $(DRY_RUN),--dry-run,) $(if $(ALLOW_STALE_PINS),--allow-stale-pins "$(ALLOW_STALE_PINS)",)

## Pin refresh — every pinned external input, its newest eligible candidate, and
## what floats unpinned; each stale pin verified alone in a throwaway worktree,
## then all passing pins together. Dry run by default (the working tree is never
## touched); APPLY=1 writes the passing pins after the combined run passes;
## DISCOVER=1 prints the report only; REPORT=FILE also writes it to FILE. Project
## pins, holds, verification targets and appliers come from
## scripts/release/update-pins.local.sh.
update-pins:
	@echo "📌 Refreshing pins..."
	bash scripts/release/update-pins.sh $(if $(APPLY),--apply,) $(if $(DISCOVER),--discover-only,) $(if $(REPORT),--report $(REPORT),) $(foreach m,$(MAJOR),--major '$(m)')

generate-pins-doc:
	@echo "📌 Writing docs/current_pins.md..."
	bash scripts/release/update-pins.sh --discover-only --pins-md docs/current_pins.md

## Tool images (containers/NAME/Containerfile): every tool target above runs in one, with
## the repository mounted read-only (scripts/dev/run.sh). dev-shell opens a shell in the dev
## image. The dev-image workflow publishes them: dev-image-push ARCH=amd64|arm64 builds and
## pushes natively per architecture, dev-image-merge joins and signs the multi-arch index,
## dev-image-sign REF=<repository@digest> signs one. update-dev-image-ref names the image this commit
## builds in containers/NAME/image.ref, as the pre-commit hook does. publish-dev-image
## (macOS) builds and pushes every unpublished image.
run-dev-shell:
	@echo "🐚 Shell in the dev image (repository read-only; target/ writable)..."
	bash scripts/dev/run.sh bash

push-dev-image:
	@echo "📦 Building and pushing tool images ($(ARCH))..."
	bash scripts/dev/publish.sh push $(ARCH)

merge-dev-image:
	@echo "📦 Publishing multi-arch tool images..."
	bash scripts/dev/publish.sh merge

sign-dev-image:
	@echo "🔏 Signing $(REF)..."
	bash scripts/dev/run.sh bash scripts/dev/sign-image.sh $(REF)

update-dev-image-ref:
	@echo "📌 Naming the tool images this commit builds..."
	bash scripts/dev/write-image-ref.sh

## Fetch the pinned dev image onto this machine, outside any commit: a commit only uses what is here.
pull-dev-image:
	@echo "📥 Pulling the pinned dev image..."
	bash scripts/dev/pull.sh

publish-dev-image:
	@echo "📦 Building, pushing and pinning unpublished tool images (Apple container)..."
	bash scripts/dev/publish.sh local

## Per-language verify.
verify-go:
	@echo "🔍 Verifying Go module..."
	bash scripts/dev/run.sh bash scripts/verify/go.sh

## Bootstrap entrypoint — consumers can also curl the script one-shot.
bootstrap-standards:
	bash scripts/bootstrap-standards.sh

## Help (auto-enumerates targets across every file in $(MAKEFILE_LIST) so
## consumers including this Makefile see their own targets alongside the
## canonical ones).

help:
	bash scripts/help.sh $(MAKEFILE_LIST)

## Workflow, Go and Helm checks, tests and release steps (each does nothing without its trait)

setup-actionlint:
	@echo "🔧 Installing actionlint..."
	bash scripts/dev/run.sh bash scripts/ci/setup-actionlint.sh

setup-zizmor:
	@echo "🔧 Installing zizmor..."
	bash scripts/dev/run.sh bash scripts/ci/setup-zizmor.sh

setup-gosec:
	@echo "🔧 Installing gosec..."
	bash scripts/dev/run.sh bash scripts/ci/setup-gosec.sh

setup-go-licenses:
	@echo "🔧 Installing go-licenses..."
	bash scripts/dev/run.sh bash scripts/ci/setup-go-licenses.sh

setup-gotestsum:
	@echo "🔧 Installing gotestsum..."
	bash scripts/dev/run.sh bash scripts/ci/setup-gotestsum.sh

setup-helm:
	@echo "🔧 Installing helm..."
	bash scripts/dev/run.sh bash scripts/ci/setup-helm.sh

setup-kubeconform:
	@echo "🔧 Installing kubeconform..."
	bash scripts/dev/run.sh bash scripts/ci/setup-kubeconform.sh

setup-kubescape:
	@echo "🔧 Installing kubescape..."
	bash scripts/dev/run.sh bash scripts/ci/setup-kubescape.sh

lint-workflows:
	@echo "🔍 Linting workflows (actionlint, zizmor)..."
	bash scripts/dev/run.sh bash scripts/lint/workflows.sh

lint-gosec:
	@echo "🔍 Running gosec..."
	bash scripts/dev/run.sh bash scripts/lint/gosec.sh

lint-licenses:
	@echo "🔍 Checking dependency licenses..."
	bash scripts/dev/run.sh bash scripts/lint/licenses.sh

lint-helm:
	@echo "🔍 Running Helm lint..."
	bash scripts/dev/run.sh bash scripts/lint/helm.sh

lint-helm-validate:
	@echo "🔍 Validating Helm templates against the Kubernetes schema..."
	bash scripts/dev/run.sh bash scripts/lint/helm-validate.sh

lint-helm-policy:
	@echo "🔍 Scanning chart policy (kubescape)..."
	bash scripts/dev/run.sh bash scripts/lint/helm-policy.sh

lint-vex:
	@echo "🔍 Validating the generated OpenVEX document..."
	bash scripts/dev/run.sh bash scripts/lint/vex.sh

test-unit-go:
	@echo "🧪 Running Go unit tests..."
	bash scripts/dev/run.sh bash scripts/test/ci.sh

test-fuzz:
	@echo "🧪 Running fuzz targets..."
	bash scripts/dev/run.sh bash scripts/test/fuzz.sh

generate-coverage-profile:
	@echo "📊 Generating the Go coverage profile (target/coverage.txt)..."
	bash scripts/dev/run.sh bash scripts/test/coverage.sh

generate-vex:
	@echo "🧾 Generating OpenVEX (govulncheck)..."
	bash scripts/dev/run.sh bash scripts/release/vex.sh $(ARGS)

generate-release-checksums:
	@echo "🔐 Generating SHA256SUMS..."
	bash scripts/dev/run.sh bash scripts/release/checksums.sh

verify-release-checksums:
	@echo "🔐 Verifying SHA256SUMS..."
	bash scripts/dev/run.sh bash scripts/release/checksums.sh --verify

set-dist-permissions:
	@echo "🔑 Making dist binaries executable..."
	DIST_OWNER='$(DIST_OWNER)' KEELCORE_DEV_ENV=DIST_OWNER bash scripts/dev/run.sh bash scripts/build/dist-chmod.sh

build-native:
	@echo "🔨 Cross-building native test binaries for $(OS)/$(ARCH)..."
	bash scripts/dev/run.sh bash scripts/test/native-build.sh $(OS) $(ARCH)

test-native:
	@echo "🧪 Running native test binaries ($(DIR))..."
	bash scripts/test/native-run.sh $(DIR)

test-native-integrity:
	@echo "🧪 Running the integrity suite natively ($(DIR))..."
	bash scripts/test/native-integrity.sh $(DIR)

# Who owns dist/ after a tool-image step on Linux (root runs the image there): the invoking user.
DIST_OWNER := $(shell [ "$$(uname -s)" = Linux ] && printf '%s:%s' "$$(id -u)" "$$(id -g)")

setup-grype:
	@echo "🔧 Installing grype..."
	bash scripts/dev/run.sh bash scripts/ci/setup-grype.sh

generate-release-metadata:
	@echo "🧾 Generating release metadata..."
	TAG='$(TAG)' KEELCORE_DEV_ENV='$(KEELCORE_DEV_ENV) TAG' bash scripts/dev/run.sh bash scripts/release/metadata.sh

publish-release-images:
	@echo "🐳 Building and pushing container images..."
	bash scripts/release/docker.sh

push-helm-chart:
	@echo "⎈ Packaging and pushing the Helm chart..."
	bash scripts/dev/run.sh bash scripts/release/helm-push.sh

login-ghcr:
	@echo "🔑 Logging in to GHCR..."
	bash scripts/release/ghcr-login.sh

run-cosign:
	@echo "🔏 cosign (GHCR, dev image) $(ARGS)..."
	bash scripts/dev/run.sh bash scripts/release/cosign.sh $(ARGS)

upload-release:
	@echo "🚀 Uploading release artifacts..."
	RELEASE_TAG=$(TAG) bash scripts/release/upload.sh $(ARGS)

verify-release:
	@echo "🔍 Verifying the published release..."
	bash scripts/release/verify-release.sh

