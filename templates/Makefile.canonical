## Universal canonical targets (language-independent; mandated by CI standards)

build: | ensure-container
	@echo "🔨 Running build..."
	bash scripts/dev/run.sh bash scripts/build.sh

lint: lint-newlines lint-markdown lint-bash lint-go lint-suppressions lint-utc lint-workflows

test: test-unit test-integration

test-unit: test-unit-go test-unit-local

## The project's own unit tests (scripts/test-unit-local.local.sh)
test-unit-local: | ensure-container
	@echo "🧪 Running the project's unit tests..."
	bash scripts/dev/run.sh bash scripts/test-unit-local.sh

test-integration: | ensure-container
	@echo "🧪 Running integration tests..."
	bash scripts/dev/run.sh bash scripts/test-integration.sh

clean:
	@echo "🧹 Cleaning..."
	bash scripts/clean.sh

## Audit

audit: check-legal-drift | ensure-container
	@echo "🔍 Running CI/Makefile audit..."
	bash scripts/dev/run.sh bash scripts/ci/audit.sh

## Lint targets

lint-newlines: | ensure-container
	@echo "🔍 Checking trailing newlines..."
	bash scripts/dev/run.sh bash scripts/lint/lint-newlines.sh

lint-utc: | ensure-container
	@echo "🕛 Checking timestamps are UTC..."
	bash scripts/dev/run.sh bash scripts/lint/lint-utc.sh

lint-bash: | ensure-container
	@echo "🔍 Running shellcheck..."
	bash scripts/dev/run.sh bash scripts/lint/lint-bash.sh

lint-markdown: | ensure-container
	@echo "🔍 Running markdown lint (markdownlint-cli2)..."
	bash scripts/dev/run.sh bash scripts/lint/lint-markdown.sh

lint-go: | ensure-container
	@echo "🔍 Running gofmt check + go vet + staticcheck..."
	bash scripts/dev/run.sh bash scripts/lint/lint-go.sh

lint-suppressions: | ensure-container
	@echo "🔍 Checking for lint-suppression directives..."
	bash scripts/dev/run.sh bash scripts/lint/lint-suppressions.sh

## Check targets

check-adr-metadata: | ensure-container
	@echo "🔍 Checking ADR metadata..."
	bash scripts/dev/run.sh bash scripts/check/check-adr-metadata.sh

check-governance-metadata: | ensure-container
	@echo "🔍 Checking governance metadata..."
	bash scripts/dev/run.sh bash scripts/check/check-governance-metadata.sh

check-rfc-metadata: | ensure-container
	@echo "🔍 Checking RFC metadata..."
	bash scripts/dev/run.sh bash scripts/check/check-rfc-metadata.sh

## Last step of every CI job that runs tool targets: the job left the working tree untouched
check-clean-tree:
	@echo "🧹 Checking the working tree is clean..."
	bash scripts/ci/check-clean-tree.sh

## The pins docs/current_pins.md lists match the pins in the tree (local, no network; also a pre-commit check)
check-pins-doc: | ensure-container
	@echo "📌 Checking docs/current_pins.md against the pins in the tree..."
	bash scripts/dev/run.sh bash scripts/release/update-pins.sh --check-pins-doc docs/current_pins.md

## The legal-file copies config/legal-copies.local.txt lists match their sources (also in audit and the pre-commit check)
check-legal-drift: | ensure-container
	@echo "⚖️  Checking legal file drift..."
	bash scripts/dev/run.sh bash scripts/check-legal-drift.sh

## Write each legal-file copy config/legal-copies.local.txt lists from its source
ensure-legal-notices: | ensure-container
	@echo "⚖️  Writing legal file copies from their sources..."
	bash scripts/dev/run.sh --writable bash scripts/ensure-legal-notices.sh

## CI gate targets

check-pr-policy: | ensure-container
	@echo "🔍 Running PR policy check..."
	bash scripts/dev/run.sh bash scripts/ci/check-pr-policy.sh

check-secrets: | ensure-container
	@echo "🔍 Running secret scan..."
	bash scripts/dev/run.sh bash scripts/ci/check-secrets.sh

check-dco: | ensure-container
	@echo "🔍 Running DCO sign-off check..."
	bash scripts/dev/run.sh bash scripts/ci/check-dco.sh

check-coverage-delta: | ensure-container
	@echo "📊 Checking coverage delta..."
	bash scripts/dev/run.sh bash scripts/test/check-coverage-delta.sh

check-governance: | ensure-container
	@echo "🚦 Governance CI gate (refresh-governance --dry-run)..."
	bash scripts/dev/run.sh bash scripts/ci/check-governance.sh

## Coverage

test-coverage: test-coverage-go test-coverage-rust merge-coverage

test-coverage-go: | ensure-container
	@echo "📊 Go coverage..."
	bash scripts/dev/run.sh bash scripts/test/test-coverage-go.sh

test-coverage-rust: | ensure-container
	@echo "📊 Rust coverage (cargo-llvm-cov)..."
	bash scripts/dev/run.sh bash scripts/test/test-coverage-rust.sh

merge-coverage: | ensure-container
	@echo "📊 Coverage aggregate (merge per-language LCOV, bucket by extension)..."
	bash scripts/dev/run.sh bash scripts/test/merge-coverage.sh

check-coverage-regression: | ensure-container
	@echo "🚦 coverage-no-regression (per-file)..."
	bash scripts/dev/run.sh bash scripts/test/check-coverage-regression.sh

generate-coverage-baseline: | ensure-container
	@echo "🪴 coverage-baseline-init (capture current LCOV)..."
	bash scripts/dev/run.sh --writable bash scripts/test/generate-coverage-baseline.sh

## Setup targets — the tool images run these installers at build time; `make setup-<tool>` runs
## one in the dev image (a throwaway install: how update-pins checks a new tool pin).

## Apple container and its kernel on this Mac, from the signed installer package (needs an administrator password).
setup-apple-container:
	@echo "🔧 Installing Apple container..."
	bash scripts/ci/setup-apple-container.sh

## The container runtime of every tool-image target (order-only prerequisite): Apple container installed and started on a Mac.
ensure-container:
	bash scripts/ci/ensure-container.sh

setup-bats: | ensure-container
	@echo "🔧 Installing bats-core test harness..."
	bash scripts/dev/run.sh bash scripts/ci/setup-bats.sh

setup-cosign: | ensure-container
	@echo "🔧 Installing cosign..."
	bash scripts/dev/run.sh bash scripts/ci/setup-cosign.sh

setup-gitleaks: | ensure-container
	@echo "🔧 Installing gitleaks..."
	bash scripts/dev/run.sh bash scripts/ci/setup-gitleaks.sh

setup-markdownlint: | ensure-container
	@echo "🔧 Installing markdownlint-cli..."
	bash scripts/dev/run.sh bash scripts/ci/setup-markdownlint.sh

setup-shellcheck: | ensure-container
	@echo "🔧 Installing shellcheck..."
	bash scripts/dev/run.sh bash scripts/ci/setup-shellcheck.sh

setup-staticcheck: | ensure-container
	@echo "🔧 Installing staticcheck..."
	bash scripts/dev/run.sh bash scripts/ci/setup-staticcheck.sh

setup-syft: | ensure-container
	@echo "🔧 Installing syft..."
	bash scripts/dev/run.sh bash scripts/ci/setup-syft.sh

setup-govulncheck: | ensure-container
	@echo "🔧 Installing govulncheck..."
	bash scripts/dev/run.sh bash scripts/ci/setup-govulncheck.sh

## Dependency vulnerability gate: reachable vulnerabilities in every repo-owned Go module
lint-vuln: | ensure-container
	@echo "🔍 Running govulncheck..."
	bash scripts/dev/run.sh bash scripts/lint/lint-vuln.sh

## The CodeQL languages the repository holds, as a workflow output (codeql.yml). Runs on the host:
## the output file lives on the runner.
detect-codeql-languages:
	@echo "🔍 Detecting CodeQL languages..."
	bash scripts/ci/detect-codeql-languages.sh

## Git hook installation (core.hooksPath scripts/hooks: one setting for clones, worktrees and submodules)

install-hooks:
	@echo "🪝 Installing git pre-commit hook..."
	bash scripts/install-hooks.sh

## Canonical script verification (compares a downstream repo's scripts/ against
## this canonical set; consumers usually do not invoke this).

verify-canonical: | ensure-container
	@echo "🔍 Verifying canonical scripts are byte-identical (REPO=<path>, default: this repo)…"
	bash scripts/dev/run.sh bash scripts/ci/verify-canonical.sh $(REPO)

## Utility targets

format: | ensure-container
	@echo "🖊️  Formatting repository..."
	bash scripts/dev/run.sh --writable bash scripts/format.sh

lint-all: | ensure-container
	@echo "🔍 Running all linters (full suite)..."
	bash scripts/dev/run.sh bash scripts/lint-all.sh

run-pre-commit:
	@echo "🪝 Running pre-commit checks..."
	bash scripts/run-pre-commit.sh

## Governance reconciliation (downstream consumers; ongoing, not first-time)
# Syncs canonical scripts from .standards/scripts/ to consumer scripts/ and
# injects any missing canonical Makefile target from
# .standards/templates/Makefile.canonical into consumer Makefile.
# `.standards` wins. Idempotent.
refresh-governance:
	bash scripts/refresh-governance.sh

## One-shot migration for consumers whose Makefile predates the include era.
## Adds the include directive and removes canonical target blocks. Idempotent.
migrate-makefile:
	bash scripts/migrate-makefile.sh

## Per-language publish targets — scripts shipped byte-identical (Rule A).
publish-go: | ensure-container
	@echo "🚀 Publishing Go module..."
	bash scripts/dev/run.sh bash scripts/release/publish-go.sh

publish-npm: | ensure-container
	@echo "🚀 Publishing npm package..."
	bash scripts/dev/run.sh --writable bash scripts/release/publish-npm.sh

## release-wait-published ARGS=npm|pypi|go: wait until the registry serves all of the version just published
## Wait for the GitHub Actions runs on this commit, then fail if any is red.
wait-for-ci:
	@echo "⏳ Waiting for CI on this commit..."
	bash scripts/release/wait-for-ci.sh

wait-for-publish: | ensure-container
	@echo "⏳ Waiting for the registry to finish publishing..."
	bash scripts/dev/run.sh bash scripts/release/wait-for-publish.sh $(ARGS)

publish-pypi: | ensure-container
	@echo "🚀 Publishing PyPI package..."
	bash scripts/dev/run.sh --image pypi bash scripts/release/publish-pypi.sh

## Release provenance — SBOM (ARGS="--out-dir DIR") and keyless signing (ARGS="<artifact> ...").
generate-sbom: | ensure-container
	@echo "🧾 Generating SBOM..."
	bash scripts/dev/run.sh bash scripts/release/generate-sbom.sh $(ARGS)

sign-release: | ensure-container
	@echo "🔏 Signing release artifacts..."
	bash scripts/dev/run.sh bash scripts/release/sign-release.sh $(ARGS)

## GitHub Release (publish workflow, after the packages are published): build-release-assets collects
## the published files in target/release with per-artifact SBOMs, build-environment SBOMs of
## the pinned tool images, current_pins.md, SHA256SUMS and cosign bundles; release-github
## creates the Release with notes and every asset; release-verify-blobs checks them all.
build-release-assets: | ensure-container
	@echo "📦 Assembling release assets for $(TAG)..."
	bash scripts/dev/run.sh bash scripts/release/build-release-assets.sh $(TAG) target/release

publish-github-release: | ensure-container
	@echo "🚀 Publishing the GitHub Release for $(TAG)..."
	bash scripts/dev/run.sh bash scripts/release/publish-github-release.sh $(TAG) target/release

verify-release-blobs: | ensure-container
	@echo "🔍 Verifying release assets..."
	bash scripts/dev/run.sh bash scripts/release/verify-release-blobs.sh target/release

## Release tagging — developer action only (governance/ci.md "Release Tagging").
## The bump level comes from the repo's own scripts/release/create-release.local.sh.
## FORCE=vX.Y.Z overrides the computed version; DRY_RUN=1 computes without tagging.
## Stale pins block the release; ALLOW_STALE_PINS="<reason>" authorizes it (audit-logged).
create-release:
	@echo "🏷️  Creating release tag..."
	bash scripts/release/create-release.sh $(if $(FORCE),--force $(FORCE),) $(if $(DRY_RUN),--dry-run,) $(if $(ALLOW_STALE_PINS),--allow-stale-pins "$(ALLOW_STALE_PINS)",)

## Pin refresh — every pinned external input, its newest eligible candidate, and
## what floats unpinned; each stale pin verified alone in a throwaway worktree,
## then all passing pins together. Dry run by default (the working tree is never
## touched); APPLY=1 writes the passing pins after the combined run passes;
## DISCOVER=1 prints the report only; REPORT=FILE also writes it to FILE. Project
## pins, holds, verification targets and appliers come from
## scripts/release/update-pins.local.sh.
update-pins: | ensure-container
	@echo "📌 Refreshing pins..."
	bash scripts/release/update-pins.sh $(if $(APPLY),--apply,) $(if $(DISCOVER),--discover-only,) $(if $(REPORT),--report $(REPORT),) $(foreach m,$(MAJOR),--major '$(m)')

generate-pins-doc: | ensure-container
	@echo "📌 Writing docs/current_pins.md..."
	bash scripts/release/update-pins.sh --discover-only --pins-md docs/current_pins.md

## Tool images (containers/NAME/Containerfile, and each build file config/tool-images.local.txt lists):
## every tool target above runs in one, with the repository mounted read-only (scripts/dev/run.sh).
## run-dev-shell opens a shell in the dev image. The dev-image workflow publishes them:
## push-dev-image ARCH=amd64|arm64 builds and pushes natively per architecture, merge-dev-image joins
## the multi-arch index and gives it and each arch image what every published image gets
## (scripts/release/sign-image.sh: a signature, an SBOM and SLSA provenance); sign-image REF=<repository@digest> does that for one image,
## from a GitHub Actions job. update-dev-image-ref names the
## image this commit builds in containers/NAME/image.ref (a listed image: <BUILD FILE>.image.ref), as
## the pre-commit hook does. publish-dev-image (macOS) builds and pushes every unpublished image.
run-dev-shell: | ensure-container
	@echo "🐚 Shell in the dev image (repository read-only; target/ writable)..."
	bash scripts/dev/run.sh bash

push-dev-image: | ensure-container
	@echo "📦 Building and pushing tool images ($(ARCH))..."
	bash scripts/dev/publish.sh push $(ARCH)

merge-dev-image: | ensure-container
	@echo "📦 Publishing multi-arch tool images..."
	bash scripts/dev/publish.sh merge

sign-image: | ensure-container
	@echo "🔏 Signing $(REF), with its SBOM and provenance..."
	bash scripts/dev/run.sh bash scripts/release/sign-image.sh $(REF)

update-dev-image-ref: | ensure-container
	@echo "📌 Naming the tool images this commit builds..."
	bash scripts/dev/update-dev-image-ref.sh

## Fetch the pinned dev image onto this machine, outside any commit: a commit only uses what is here.
pull-dev-image: | ensure-container
	@echo "📥 Pulling the pinned dev image..."
	bash scripts/dev/pull-dev-image.sh

publish-dev-image: | ensure-container
	@echo "📦 Building, pushing and pinning unpublished tool images (Apple container)..."
	bash scripts/dev/publish.sh local

## Per-language verify.
verify-go: | ensure-container
	@echo "🔍 Verifying Go module..."
	bash scripts/dev/run.sh bash scripts/verify/verify-go.sh

## Bootstrap entrypoint — consumers can also curl the script one-shot.
bootstrap-standards:
	bash scripts/bootstrap-standards.sh

## Help (auto-enumerates targets across every file in $(MAKEFILE_LIST) so
## consumers including this Makefile see their own targets alongside the
## canonical ones).

help:
	bash scripts/help.sh $(MAKEFILE_LIST)

## Workflow, Go and Helm checks, tests and release steps (each does nothing without its trait)

setup-actionlint: | ensure-container
	@echo "🔧 Installing actionlint..."
	bash scripts/dev/run.sh bash scripts/ci/setup-actionlint.sh

setup-zizmor: | ensure-container
	@echo "🔧 Installing zizmor..."
	bash scripts/dev/run.sh bash scripts/ci/setup-zizmor.sh

setup-gosec: | ensure-container
	@echo "🔧 Installing gosec..."
	bash scripts/dev/run.sh bash scripts/ci/setup-gosec.sh

setup-go-licenses: | ensure-container
	@echo "🔧 Installing go-licenses..."
	bash scripts/dev/run.sh bash scripts/ci/setup-go-licenses.sh

setup-gotestsum: | ensure-container
	@echo "🔧 Installing gotestsum..."
	bash scripts/dev/run.sh bash scripts/ci/setup-gotestsum.sh

setup-helm: | ensure-container
	@echo "🔧 Installing helm..."
	bash scripts/dev/run.sh bash scripts/ci/setup-helm.sh

setup-kubeconform: | ensure-container
	@echo "🔧 Installing kubeconform..."
	bash scripts/dev/run.sh bash scripts/ci/setup-kubeconform.sh

setup-kubescape: | ensure-container
	@echo "🔧 Installing kubescape..."
	bash scripts/dev/run.sh bash scripts/ci/setup-kubescape.sh

lint-workflows: | ensure-container
	@echo "🔍 Linting workflows (actionlint, zizmor)..."
	bash scripts/dev/run.sh bash scripts/lint/lint-workflows.sh

lint-gosec: | ensure-container
	@echo "🔍 Running gosec..."
	bash scripts/dev/run.sh bash scripts/lint/lint-gosec.sh

lint-licenses: | ensure-container
	@echo "🔍 Checking dependency licenses..."
	bash scripts/dev/run.sh bash scripts/lint/lint-licenses.sh

lint-helm: | ensure-container
	@echo "🔍 Running Helm lint..."
	bash scripts/dev/run.sh bash scripts/lint/lint-helm.sh

lint-helm-validate: | ensure-container
	@echo "🔍 Validating Helm templates against the Kubernetes schema..."
	bash scripts/dev/run.sh bash scripts/lint/lint-helm-validate.sh

lint-helm-policy: | ensure-container
	@echo "🔍 Scanning chart policy (kubescape)..."
	bash scripts/dev/run.sh bash scripts/lint/lint-helm-policy.sh

lint-vex: | ensure-container
	@echo "🔍 Validating the generated OpenVEX document..."
	bash scripts/dev/run.sh bash scripts/lint/lint-vex.sh

test-unit-go: | ensure-container
	@echo "🧪 Running Go unit tests..."
	bash scripts/dev/run.sh bash scripts/test/test-unit-go.sh

test-fuzz: | ensure-container
	@echo "🧪 Running fuzz targets..."
	bash scripts/dev/run.sh bash scripts/test/test-fuzz.sh

generate-coverage-profile: | ensure-container
	@echo "📊 Generating the Go coverage profile (target/coverage.txt)..."
	bash scripts/dev/run.sh bash scripts/test/generate-coverage-profile.sh

generate-vex: | ensure-container
	@echo "🧾 Generating OpenVEX (govulncheck)..."
	bash scripts/dev/run.sh bash scripts/release/generate-vex.sh $(ARGS)

generate-release-checksums: | ensure-container
	@echo "🔐 Generating SHA256SUMS..."
	bash scripts/dev/run.sh bash scripts/release/generate-release-checksums.sh

verify-release-checksums: | ensure-container
	@echo "🔐 Verifying SHA256SUMS..."
	bash scripts/dev/run.sh bash scripts/release/generate-release-checksums.sh --verify

set-dist-permissions: | ensure-container
	@echo "🔑 Making dist binaries executable..."
	bash scripts/dev/run.sh bash scripts/build/set-dist-permissions.sh

build-native: | ensure-container
	@echo "🔨 Cross-building native test binaries for $(OS)/$(ARCH)..."
	bash scripts/dev/run.sh bash scripts/test/build-native.sh $(OS) $(ARCH)

test-native:
	@echo "🧪 Running native test binaries ($(DIR))..."
	bash scripts/test/test-native.sh $(DIR)

test-native-integrity:
	@echo "🧪 Running the integrity suite natively ($(DIR))..."
	bash scripts/test/test-native-integrity.sh $(DIR)

# Who owns dist/ after a tool-image step on Linux (root runs the image there): the invoking user. Exported:
# set-dist-permissions.sh reads it in the dev image, and run.sh passes it only from the environment.
export DIST_OWNER := $(shell [ "$$(uname -s)" = Linux ] && printf '%s:%s' "$$(id -u)" "$$(id -g)")

setup-grype: | ensure-container
	@echo "🔧 Installing grype..."
	bash scripts/dev/run.sh bash scripts/ci/setup-grype.sh

generate-release-metadata: | ensure-container
	@echo "🧾 Generating release metadata..."
	bash scripts/dev/run.sh bash scripts/release/generate-release-metadata.sh

publish-release-images: | ensure-container
	@echo "🐳 Building and pushing container images..."
	bash scripts/release/publish-release-images.sh

push-helm-chart: | ensure-container
	@echo "⎈ Packaging and pushing the Helm chart..."
	bash scripts/dev/run.sh bash scripts/release/push-helm-chart.sh

login-ghcr:
	@echo "🔑 Logging in to GHCR..."
	bash scripts/release/login-ghcr.sh

run-cosign: | ensure-container
	@echo "🔏 cosign (GHCR, dev image) $(ARGS)..."
	bash scripts/dev/run.sh bash scripts/release/run-cosign.sh $(ARGS)

upload-release:
	@echo "🚀 Uploading release artifacts..."
	RELEASE_TAG=$(TAG) bash scripts/release/upload-release.sh $(ARGS)

verify-release: | ensure-container
	@echo "🔍 Verifying the published release..."
	bash scripts/release/verify-release.sh
